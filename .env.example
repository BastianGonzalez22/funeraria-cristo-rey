APP_NAME="Funeraria Cristo Rey"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de datos (MySQL 8, según el informe) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=funeraria_cristo_rey
DB_USERNAME=root
DB_PASSWORD=

# Alternativa rápida para probar sin MySQL:
# DB_CONNECTION=sqlite
# (y crear el archivo vacío database/database.sqlite)

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# --- Datos de la funeraria ---
FUNERARIA_TELEFONO="+56 9 1234 5678"
FUNERARIA_WHATSAPP=56912345678
FUNERARIA_EMAIL=contacto@funerariacristorey.cl
FUNERARIA_DIRECCION="Temuco, Región de La Araucanía"
BODEGA_CAPACIDAD=30

# --- Datos para que las familias abonen por transferencia (portal) ---
FUNERARIA_BANCO="Banco Estado"
FUNERARIA_TIPO_CUENTA="Cuenta corriente"
FUNERARIA_NUMERO_CUENTA="000-0-000000-0"
FUNERARIA_TITULAR="Funeraria Cristo Rey"
FUNERARIA_RUT="76.000.000-0"
